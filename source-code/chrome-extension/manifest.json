{
  "manifest_version": 3,
  "name": "HProxy: Proxy Connector and Checker",
  "version": "1.0.0",
  "minimum_chrome_version": "110",
  "description": "Connect Chrome through your own proxy in one click and see what it really does, or through a tested free proxy by country.",
  "key": "",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HProxy: Proxy Connector and Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
