<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package of the app (MSIX). scripts/msix.mjs fills in the version and packs
  it with the release build; the Store signs it when it is published.

  Identity: Partner Center, product 9NPDSV0K3J1X, "Product identity". The Store refuses a package
  whose Name, Publisher or display names differ from what is reserved there. "HProxy" alone was
  already reserved by someone else (2026-09-25), so both display names are the reserved
  "HProxy: Proxy Connector and Checker".

  Connect writes the system proxy into the user's Internet Settings key (engine/hproxy-system).
  Windows gives a packaged app a private copy of HKEY_CURRENT_USER, where that write would change
  nothing, so the key is declared unvirtualized: on Windows 11 only that key
  (virtualization:ExcludedKeys), on Windows 10 all of HKCU (desktop6, the only form it knows).
  Both need the restricted capability unvirtualizedResources, which the submission explains.

  The app is also the command-line tool (src-tauri/src/main.rs): `hproxy` is its execution
  alias, which Windows keeps on the PATH, so an AI assistant can start `hproxy mcp`.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap uap3 desktop desktop6 rescap virtualization">

  <Identity
    Name="HProxy.HProxyProxyConnectorandChecker"
    Publisher="CN=F0C9B3EF-878C-41D2-B9B7-0355DBD29889"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>HProxy: Proxy Connector and Checker</DisplayName>
    <PublisherDisplayName>HProxy</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <virtualization:RegistryWriteVirtualization>
      <virtualization:ExcludedKeys>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings</virtualization:ExcludedKey>
      </virtualization:ExcludedKeys>
    </virtualization:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="HProxy" Executable="hproxy-checker.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="HProxy: Proxy Connector and Checker"
        Description="Check proxies, and connect Windows through your own proxy or a tested free one."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="hproxy-checker.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="hproxy.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
