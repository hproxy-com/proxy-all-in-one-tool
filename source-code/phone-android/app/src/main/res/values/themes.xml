<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The window Android shows while the app starts, in the app's own night colour (the app
         starts dark), with light status bar icons. The screens draw everything else. -->
    <style name="Theme.HProxy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- Android's own calendar, where the last day of a plan is picked (ui/proxies/Rows.kt,
         pickDay): dark like the app, its day and buttons in the app's blue. -->
    <style name="Theme.HProxy.Calendar" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">@color/blue</item>
    </style>
</resources>
