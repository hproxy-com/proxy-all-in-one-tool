App(
    appid="hproxy",
    name="HProxy",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="hproxy_app",
    stack_size=6 * 1024,
    fap_category="GPIO",
    fap_icon="icon.png",
    fap_version="1.2",
    fap_author="HProxy",
    fap_weburl="https://github.com/hproxy-com/proxy-all-in-one-tool/tree/main/flipper-zero",
    fap_description="Your own proxies: add any kind, check every protocol, steer your hproxy connector. Over FlipperHTTP.",
    # The tests in tests/ are built on a computer, never into the app.
    sources=[
        "hproxy.c",
        "hproxy_api.c",
        "hproxy_keys.c",
        "keyboard.c",
        "flipper_http/flipper_http.c",
    ],
)
